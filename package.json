{
  "name": "phl-command-hub",
  "private": true,
  "description": "Phoenix Legacy — APC console (Netlify) + Migration Command (Vinext)",
  "version": "2.0.0",
  "scripts": {
    "start:apc": "python3 -m http.server 5500 --directory legacy/apc-console",
    "start": "python3 -m http.server 5500",
    "deploy": "npx --yes netlify-cli deploy --dir=. --prod",
    "migration:install": "npm run install:ci --prefix apps/migration-command",
    "migration:dev": "npm run dev --prefix apps/migration-command",
    "migration:build-netlify": "node scripts/build-migration-netlify.mjs"
  },
